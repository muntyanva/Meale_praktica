# ==============================================================================
# Mealie Environment Configuration Example
# Скопируйте этот файл в .env и заполните значения перед запуском docker compose
# (Скрипт setup.sh делает это автоматически, но этот файл полезен для документации)
# ==============================================================================

# ------------------------------------------------------------------------------
# Сетевые настройки
# ------------------------------------------------------------------------------
# Порт, на котором Mealie будет доступен на хост-машине
MEALIE_EXTERNAL_PORT=9091

# Базовый URL вашего приложения (используется для генерации ссылкок в письмах и API)
BASE_URL=http://localhost:9091

# ------------------------------------------------------------------------------
# Настройки безопасности
# ------------------------------------------------------------------------------
# Случайная строка для шифрования сессий и токенов. 
# Сгенерируйте через: openssl rand -hex 32
SECRET_KEY=your_super_secret_32_character_hex_string_here

# Разрешить ли новым пользователям регистрироваться самостоятельно
# true  = регистрация открыта
# false = регистрация закрыта (пользователей создает только админ)
ALLOW_SIGNUP=false

# Уровень логирования: debug, info, warning, error, critical
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Настройки базы данных (PostgreSQL)
# ------------------------------------------------------------------------------
# Имя пользователя базы данных
POSTGRES_USER=mealie

# Пароль пользователя базы данных. 
# Сгенерируйте через: openssl rand -hex 16
POSTGRES_PASSWORD=your_random_postgres_password_here

# Имя базы данных
POSTGRES_DB=mealie

# (Опционально) Порт базы данных внутри сети Docker (обычно не требует изменения)
# POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# Настройки кэширования (Redis)
# ------------------------------------------------------------------------------
# Пароль для Redis. 
# Сгенерируйте через: openssl rand -hex 16
REDIS_PASSWORD=your_random_redis_password_here